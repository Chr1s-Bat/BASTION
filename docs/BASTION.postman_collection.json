{
  "info": {
    "name": "BASTION API",
    "description": "Every endpoint of the BASTION Laravel API. Run \"1. Auth\" first: both logins store tokens in collection variables. Works in Postman and Thunder Client (Import → Postman collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "officerToken",
      "value": ""
    },
    {
      "key": "throwawayToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": "1"
    },
    {
      "key": "requisitionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST /register (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Recruit {{$randomLastName}}\",\n  \"email\": \"recruit{{$randomInt}}@bastion.test\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"rank\": \"Private\",\n  \"unit\": \"Alpha Company\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201]);",
                  "});",
                  "pm.test('Returns a token and role=user', function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.token).to.be.a('string');",
                  "  pm.expect(j.user.role).to.eql('user');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bastion.test\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token saved as adminToken', function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.token).to.be.a('string');",
                  "  pm.collectionVariables.set('adminToken', j.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /login (officer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"officer@bastion.test\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token saved as officerToken', function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.token).to.be.a('string');",
                  "  pm.collectionVariables.set('officerToken', j.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /user (current user)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{officerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Has user data', function () { pm.expect(pm.response.json().data.email).to.eql('officer@bastion.test'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /logout (revokes a throw-away token)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/login', method: 'POST',",
                  "  header: { 'Content-Type': 'application/json', Accept: 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: 'officer@bastion.test', password: 'Password123!' }) } },",
                  "  function (err, res) { pm.collectionVariables.set('throwawayToken', res.json().token); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{throwawayToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
